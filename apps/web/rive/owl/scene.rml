        <!-- Pet: three layers that never key the same property.
             Blink owns the upper lids' scaleY, Look owns x offsets (head turn
             parallax), Mood owns everything else and keys the full set in every
             state, so an interrupted one-shot can never strand a pose. -->
        <StateMachine name="Pet" id="0:100">
            <StateMachineListenerSingle targetId="0:30" listenerTypeValue="click" name="Pat" id="0:150">
                <ListenerViewModelChange>
                    <BindablePropertyTrigger propertyValue="1">
                        <DataBindContext sourcePathIds="0:300-0:312" propertyKey="686" direction="true"/>
                    </BindablePropertyTrigger>
                </ListenerViewModelChange>
            </StateMachineListenerSingle>

            <StateMachineLayer name="Blink" id="0:101">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:110"/>
                </EntryState>
                <AnimationState x="200" y="0" animationId="0:200" id="0:110"/>
            </StateMachineLayer>

            <StateMachineLayer name="Look" id="0:102">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState x="0" y="0">
                    <StateTransition stateToId="0:120"/>
                </EntryState>
                <BlendState1DViewModel x="200" y="0" id="0:120">
                    <BindablePropertyNumber>
                        <DataBindContext sourcePathIds="0:300-0:311" propertyKey="636"/>
                    </BindablePropertyNumber>
                    <BlendAnimation1D animationId="0:201" value="0"/>
                    <BlendAnimation1D animationId="0:202" value="50"/>
                    <BlendAnimation1D animationId="0:203" value="100"/>
                </BlendState1DViewModel>
            </StateMachineLayer>

            <StateMachineLayer name="Mood" id="0:103">
                <AnyState x="150" y="-200">
                    <StateTransition stateToId="0:132" duration="90">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:300-0:312" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                    <StateTransition stateToId="0:133" duration="70">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyTrigger>
                                    <DataBindContext sourcePathIds="0:300-0:313" propertyKey="686"/>
                                </BindablePropertyTrigger>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueTriggerComparator/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnyState>
                <ExitState x="600" y="-200"/>
                <EntryState x="-200" y="0">
                    <StateTransition stateToId="0:130"/>
                </EntryState>
                <AnimationState x="0" y="0" animationId="0:204" id="0:130">
                    <StateTransition stateToId="0:131" duration="320" interpolationType="cubic" enableEarlyExit="true">
                        <CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/>
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
                                    <DataBindContext sourcePathIds="0:300-0:310" propertyKey="634"/>
                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="300" y="0" animationId="0:205" id="0:131">
                    <StateTransition stateToId="0:130" duration="360" interpolationType="cubic" enableEarlyExit="true">
                        <CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/>
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean>
