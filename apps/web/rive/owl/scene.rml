                                </BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="0" y="-360" animationId="0:206" reset="true" id="0:132">
                    <StateTransition stateToId="0:130" duration="160" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <AnimationState x="300" y="-360" animationId="0:207" reset="true" id="0:133">
