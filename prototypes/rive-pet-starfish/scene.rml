<Rive version="1" kind="fragment">
    <!-- Tara, Cogna's starfish. Pure Rive: vector shapes, one timeline per mood, and a state
         machine that switches moods from the view model number "mood"
         (0 idle, 1 excited, 2 playful, 3 thinking). The four buttons set it with a tap. -->
    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" styleId="0:5" width="480" height="520" clip="true" name="Tara" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>
        <Fill name="Background">
            <SolidColor colorValue="FFF4F7F3" name="Color"/>
        </Fill>

        <!-- labels first: earlier elements draw in front -->
        <Text x="75" y="476" originX="0.5" originY="0.5" name="Label Idle">
            <TextStylePaint fontSize="15" fontAssetId="0:91" name="Btn1" id="0:80">
                <Fill name="Fill"><SolidColor colorValue="FF16241D" name="Color"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="0:80" text="idle" name="Run"/>
        </Text>
        <Text x="185" y="476" originX="0.5" originY="0.5" name="Label Excited">
            <TextStylePaint fontSize="15" fontAssetId="0:91" name="Btn2" id="0:81">
                <Fill name="Fill"><SolidColor colorValue="FF16241D" name="Color"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="0:81" text="excited" name="Run"/>
        </Text>
        <Text x="295" y="476" originX="0.5" originY="0.5" name="Label Playful">
            <TextStylePaint fontSize="15" fontAssetId="0:91" name="Btn3" id="0:82">
                <Fill name="Fill"><SolidColor colorValue="FF16241D" name="Color"/></Fill>
            </TextStylePaint>
