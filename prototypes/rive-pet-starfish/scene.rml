        <Text x="405" y="476" originX="0.5" originY="0.5" name="Label Thinking">
            <TextStylePaint fontSize="15" fontAssetId="0:91" name="Btn4" id="0:83">
                <Fill name="Fill"><SolidColor colorValue="FF16241D" name="Color"/></Fill>
            </TextStylePaint>
            <TextValueRun styleId="0:83" text="thinking" name="Run"/>
