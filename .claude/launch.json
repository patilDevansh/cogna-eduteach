{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@cogna/api",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@cogna/web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api-fake",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@cogna/api",
        "start"
      ],
      "port": 3098,
      "env": {
        "PORT": "3098",
        "LOTUS_E2E_FAKE_MODEL": "true",
        "LOTUS_E2E_DISABLE_QUESTION_BANK": "true"
      }
    },
    {
      "name": "api-built",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@cogna/api",
        "start"
      ],
      "port": 3001,
      "env": {
        "PORT": "3001",
        "LOTUS_DEV_OBSERVER_BYPASS": "true"
      }
    },
    {
      "name": "api-attach",
      "port": 3001,
      "url": "http://localhost:3001"
    },
    {
      "name": "gov007-web-module",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@cogna/web",
        "exec",
        "next",
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "4332"
      ],
      "port": 4332,
      "env": {
        "NEXT_PUBLIC_API_URL": "http://127.0.0.1:4333",
        "NEXT_PUBLIC_MODULE_LEARNING_ENABLED": "true",
        "COGNA_REVIEW_DIST_DIR": ".next-review-4322"
      }
    },
    {
      "name": "gov007-web-exercise",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@cogna/web",
        "exec",
        "next",
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "4310"
      ],
      "port": 4310,
      "env": {
        "NEXT_PUBLIC_API_URL": "http://127.0.0.1:4313"
      }
    },
    {
      "name": "gov007-web-lesson",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@cogna/web",
        "exec",
        "next",
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "4310"
      ],
      "port": 4310,
      "env": {
        "NEXT_PUBLIC_API_URL": "http://127.0.0.1:4311"
      }
    }
  ]
}