{
  "name": "cogna",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @cogna/database generate",
    "db:push": "pnpm --filter @cogna/database push",
    "db:seed": "pnpm --filter @cogna/database seed",
    "db:studio": "pnpm --filter @cogna/database studio",
    "test:golden": "pnpm --filter @cogna/api test",
    "test:content": "node scripts/validate-content-manifest.mjs",
    "test:scenario:baseline": "node scripts/cogna-cli/index.mjs run baseline-12-slot",
    "test:scenario:session-end": "node scripts/cogna-cli/index.mjs run session-end-summary",
    "test:scenario:revision": "node scripts/cogna-cli/index.mjs run revision-queue-proposal",
    "test:scenario:idempotent": "node scripts/cogna-cli/index.mjs run idempotent-retry",
    "test:scenario:targeting": "node scripts/cogna-cli/index.mjs run targeting-explanation-retest",
    "test:scenario:skip": "node scripts/cogna-cli/index.mjs run skip-question",
    "test:scenario:retention": "node scripts/cogna-cli/index.mjs run retention-review-due",
    "test:scenario:weekly-report": "node scripts/cogna-cli/index.mjs run weekly-report",
    "test:scenario:fatigue-break": "node scripts/cogna-cli/index.mjs run fatigue-break",
    "test:scenario:explanation-effectiveness": "node scripts/cogna-cli/index.mjs run explanation-effectiveness",
    "test:scenario:email-report": "node scripts/cogna-cli/index.mjs run email-report-delivery",
    "test:scenario:content-approval-gate": "node scripts/cogna-cli/index.mjs run content-approval-gate",
    "test:scenario:all": "node scripts/cogna-cli/index.mjs run baseline-12-slot && node scripts/cogna-cli/index.mjs run session-end-summary && node scripts/cogna-cli/index.mjs run revision-queue-proposal && node scripts/cogna-cli/index.mjs run idempotent-retry && node scripts/cogna-cli/index.mjs run targeting-explanation-retest && node scripts/cogna-cli/index.mjs run skip-question && node scripts/cogna-cli/index.mjs run retention-review-due && node scripts/cogna-cli/index.mjs run weekly-report && node scripts/cogna-cli/index.mjs run fatigue-break && node scripts/cogna-cli/index.mjs run explanation-effectiveness && node scripts/cogna-cli/index.mjs run email-report-delivery && node scripts/cogna-cli/index.mjs run content-approval-gate",
    "test:smoke:ui": "node scripts/ui-baseline-flow-test.mjs",
    "test:smoke:ui:mvp2": "node scripts/ui-mvp2-smoke.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
