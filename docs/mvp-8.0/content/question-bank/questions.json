    {
      "id": "Q_EXP_P1_D1_001",
      "conceptId": "EXP_P1_LAWS_OF_EXPONENTS",
      "difficulty": 1,
      "stem": "Simplify: x^4 * x^3",
      "acceptedAnswers": [
        "x^7"
      ],
      "misconceptionsTested": [
        "EXPONENT_LAW_MISAPPLICATION"
      ],
      "misconceptionAnswerPatterns": [
        {
          "misconceptionId": "EXPONENT_LAW_MISAPPLICATION",
          "answers": [
            "x^12"
          ]
        }
      ],
      "solutionSteps": [
        "a^m * a^n = a^(m+n)",
        "x^(4+3) = x^7"
      ],
      "hintLadder": [
        "When multiplying the same base, ADD the exponents.",
        "4 + 3 = 7.",
        "x^7."
      ],
      "questionIntent": "STANDARD_PRACTICE",
      "type": "NUMERIC",
      "prerequisiteConceptIds": [],
      "reviewStatus": "PENDING_REVIEW",
      "version": 1,
      "itemQualityWeight": 1,
      "unitId": "exponents-algebra"
    },
    {
