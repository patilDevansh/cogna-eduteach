    {
      "id": "Q_EXP_C2_D2_001",
      "conceptId": "EXP_C2_EXPONENTS_IN_SIMPLIFICATION",
      "difficulty": 2,
      "stem": "Simplify: (x^3 * x^5) / x^2",
      "acceptedAnswers": [
        "x^6"
      ],
      "misconceptionsTested": [
        "EXPONENT_LAW_MISAPPLICATION"
      ],
      "misconceptionAnswerPatterns": [
        {
          "misconceptionId": "EXPONENT_LAW_MISAPPLICATION",
          "answers": [
            "x^8"
          ]
        }
      ],
      "solutionSteps": [
        "x^3 * x^5 = x^8",
        "x^8 / x^2 = x^6"
      ],
      "hintLadder": [
        "First combine the top: 3+5=8.",
        "Then subtract the bottom's exponent: 8-2=6.",
        "x^6."
      ],
