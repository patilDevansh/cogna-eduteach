          "answers": [
            "x^-4",
            "1/x^4"
          ]
        }
      ],
      "solutionSteps": [
        "a^m / a^n = a^(m-n)",
        "x^(7-3) = x^4"
      ],
      "hintLadder": [
        "When dividing the same base, SUBTRACT the exponents (top minus bottom).",
        "7 - 3 = 4.",
        "x^4."
      ],
