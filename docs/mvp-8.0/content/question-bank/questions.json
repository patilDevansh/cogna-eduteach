    {
      "id": "Q_EXP_C2_D3_002",
      "conceptId": "EXP_C2_EXPONENTS_IN_SIMPLIFICATION",
      "difficulty": 3,
      "stem": "Simplify: x^6 / x^-2",
      "acceptedAnswers": [
        "x^8"
      ],
      "misconceptionsTested": [
        "NEGATIVE_EXPONENT_SIGN_FLIP"
      ],
      "misconceptionAnswerPatterns": [
        {
          "misconceptionId": "NEGATIVE_EXPONENT_SIGN_FLIP",
          "answers": [
            "x^4"
          ]
        }
      ],
      "solutionSteps": [
        "x^6 / x^-2 = x^(6-(-2))",
        "= x^8"
      ],
      "hintLadder": [
        "Subtracting a negative exponent is the same as adding.",
        "6 - (-2) = 8.",
        "x^8."
      ],
      "questionIntent": "STANDARD_PRACTICE",
