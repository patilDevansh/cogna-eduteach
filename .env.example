# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cogna?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Pilot teacher invitations. Each code must be unique and issued by the school.
# Replace this example in staging/production; do not use a shared school-wide code.
TEACHER_PILOT_INVITATIONS='[{"email":"ananya@gurukul.edu","code":"GURUKUL-2026","teacherName":"Ananya Rao","schoolId":"gurukul-pilot","schoolName":"Gurukul"}]'

# AI
OPENAI_API_KEY=

# Cogna Lotus — local/demo-only dual-model AI diagnostic experiment.
# It is intentionally isolated from diagnostic-v2. A narrow arithmetic referee
# establishes numeric truth before the AIs interpret the educational evidence.
LOTUS_EXPERIMENTAL_ENABLED="true"
# Local presentation fallback only: lets the Lotus API boot without PostgreSQL.
# All non-Lotus database-backed routes remain unavailable in this mode.
LOTUS_STANDALONE_DEMO="false"
LOTUS_OPENAI_MODEL="gpt-5.6-terra"
# Both agents reuse OPENAI_API_KEY but receive independent contexts and roles.
# The challenger is intentionally the stronger final-audit model.
LOTUS_CHALLENGER_MODEL="gpt-5.6-sol"

# Live agentic (C-lite shadow / serve) — see COGNA/LIVE_AGENTIC_PLAN.md
# GENERATE=true runs generate+verify+shadow log on SHOW_QUESTION (default bank serve)
LIVE_AGENTIC_GENERATE="false"
# SERVE_GENERATED=true only after flip criteria; kill switch when false
LIVE_AGENTIC_SERVE_GENERATED="false"
LIVE_AGENTIC_MODEL="gpt-4.1-mini"

# AI decision agents (re-rank within legal scored candidates) — see COGNA/LIVE_AGENTIC_PLAN.md
# GENERATE=true: shadow-compare AI pick vs rules (student still gets rules)
AI_QUESTION_RECOMMENDER_GENERATE="false"
# SERVE=true: await AI and apply its index when valid (still legal-set only); kill switch when false
AI_QUESTION_RECOMMENDER_SERVE="false"
# AI_QUESTION_RECOMMENDER_MODEL="gpt-4.1-mini"

# Micro-skill step diagnostic (MVP 9.0.1 Phase A) — see COGNA 9.0.1/BUILD_PLAN.md
# Deliberately the only capabilities in this repo that default ON: this slice
# exists to genuinely serve AI decisions, not to sit shadow-only. Everything is
# still gated on OPENAI_API_KEY being set, every path is bounds- or
# forbidden-term-checked, and every path falls back to a deterministic result
# when the call fails or times out. Set any of these to "false" as a kill switch.
AI_DIAGNOSTIC_V2_SELECTOR_GENERATE="true"
AI_DIAGNOSTIC_V2_SELECTOR_SERVE="true"
AI_DIAGNOSTIC_V2_INTERPRETER_GENERATE="true"
AI_DIAGNOSTIC_V2_INTERPRETER_SERVE="true"
# Grader only ever runs on a line the deterministic verifier could not read.
AI_DIAGNOSTIC_V2_GRADER_GENERATE="true"
AI_DIAGNOSTIC_V2_GRADER_SERVE="true"
# Second round-trip after selection when the model asks to author a new equation.
# Prefer templates when this path is slow; never raise the student's wait for it.
AI_DIAGNOSTIC_V2_AUTHOR_GENERATE="true"
AI_DIAGNOSTIC_V2_AUTHOR_SERVE="true"

# Report prose polish (MVP 9.0.1 Phase D) — see COGNA 9.0.1/BUILD_PLAN_D.md
# Default OFF (unlike diagnostic-v2). When GENERATE is on, AI rewrites student/
# parent session + weekly parent renderedText; SERVE must also be true to store
# the polish. Forbidden-term + numeric cross-check gates reject unsafe prose
# back to the deterministic template. INTERNAL stays template-only.
AI_REPORT_GENERATOR_GENERATE="false"
AI_REPORT_GENERATOR_SERVE="false"
# AI_REPORT_GENERATOR_MODEL="gpt-4.1-mini"

# Analytics & Monitoring
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

# MVP 3.0 Feature Flags
EXPERIMENTS_ENABLED="false"
CONTENT_LLM_DRAFTS_ENABLED="false"

# Research / A/B stub (targeted | random) — legacy MVP 2.0
EXPERIMENT_VARIANT="targeted"

# Manual cron stub: POST /jobs/weekly-reports/run

# Item-quality calibration loop (item-quality-v1)
# Opt-in interval refresh of ItemStatistic + Question.itemQualityWeight.
# Unset (default) = disabled; deploy-time alternative is a platform cron
# hitting POST /jobs/item-statistics/refresh. Never runs on the student hot path.
# ITEM_STATS_REFRESH_INTERVAL_MINUTES="60"

# Personalized video renderer. When COGNA_VIDEO_RENDER_ENDPOINT is unset,
# the local Remotion renderer runs in the API/web worker (development default).
# Do not put these values in NEXT_PUBLIC_* — they must stay server-side.
COGNA_VIDEO_RENDER_ENDPOINT=
COGNA_VIDEO_RENDER_TOKEN=
# Set to "false" to disable the local Remotion renderer even without a remote endpoint.
# COGNA_VIDEO_LOCAL_RENDERER="true"
COGNA_CHROME_PATH=
COGNA_MEDIA_STORAGE_BUCKET=
COGNA_MEDIA_CDN_URL=
# Local development storage. Public URLs are served by the web app at /generated-media/*.
COGNA_MEDIA_LOCAL_DIR=
COGNA_MEDIA_PUBLIC_BASE_URL="http://localhost:3000/generated-media"
# HMAC secret for student/teacher session tokens. Required in staging/production.
COGNA_SESSION_SECRET=
# Local-only labelled insecure fallback. Ignored when NODE_ENV=production or COGNA_ENV=staging|production.
COGNA_ALLOW_INSECURE_LOCAL_SESSION_SECRET="true"
# Worker/callback credential for POST /jobs/personalized-video-render/run
# and POST /personalized-videos/render-callback.
COGNA_JOB_WORKER_TOKEN=
# Set to "false" to disable the Nest/Next render worker interval.
# COGNA_VIDEO_RENDER_WORKER="true"
# COGNA_VIDEO_RENDER_WORKER_MS="2500"
# Demo student HMAC sessions and template seeds. Off in production unless
# explicitly enabled.
ALLOW_DEMO_STUDENT_SESSIONS="true"
ALLOW_PERSONALIZED_VIDEO_DEMO_SEEDS="true"

# API
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Local dev only — serves PENDING_REVIEW questions from the milestone bank.
# Staging/production: omit or set to "false" so only APPROVED questions reach students.
ALLOW_PENDING_REVIEW_QUESTIONS="true"

# Staging example (do not enable pending review outside local dev):
# ALLOW_PENDING_REVIEW_QUESTIONS="false"
