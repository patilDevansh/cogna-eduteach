# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cogna?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# AI
OPENAI_API_KEY=

# Live agentic (C-lite shadow / serve) — see COGNA/LIVE_AGENTIC_PLAN.md
# GENERATE=true runs generate+verify+shadow log on SHOW_QUESTION (default bank serve)
LIVE_AGENTIC_GENERATE="false"
# SERVE_GENERATED=true only after flip criteria; kill switch when false
LIVE_AGENTIC_SERVE_GENERATED="false"
LIVE_AGENTIC_MODEL="gpt-4.1-mini"

# AI decision agents (re-rank within legal scored candidates) — see COGNA/LIVE_AGENTIC_PLAN.md
# GENERATE=true: shadow-compare AI pick vs rules (student still gets rules)
AI_QUESTION_RECOMMENDER_GENERATE="false"
# SERVE=true: await AI and apply its index when valid (still legal-set only); kill switch when false
AI_QUESTION_RECOMMENDER_SERVE="false"
# AI_QUESTION_RECOMMENDER_MODEL="gpt-4.1-mini"

# Micro-skill step diagnostic (MVP 9.0.1 Phase A) — see COGNA 9.0.1/BUILD_PLAN.md
# Deliberately the only capabilities in this repo that default ON: this slice
# exists to genuinely serve AI decisions, not to sit shadow-only. Everything is
# still gated on OPENAI_API_KEY being set, every path is bounds- or
# forbidden-term-checked, and every path falls back to a deterministic result
# when the call fails or times out. Set any of these to "false" as a kill switch.
AI_DIAGNOSTIC_V2_SELECTOR_GENERATE="true"
AI_DIAGNOSTIC_V2_SELECTOR_SERVE="true"
AI_DIAGNOSTIC_V2_INTERPRETER_GENERATE="true"
AI_DIAGNOSTIC_V2_INTERPRETER_SERVE="true"
# Grader only ever runs on a line the deterministic verifier could not read.
AI_DIAGNOSTIC_V2_GRADER_GENERATE="true"
AI_DIAGNOSTIC_V2_GRADER_SERVE="true"
# Second round-trip after selection when the model asks to author a new equation.
# Prefer templates when this path is slow; never raise the student's wait for it.
AI_DIAGNOSTIC_V2_AUTHOR_GENERATE="true"
AI_DIAGNOSTIC_V2_AUTHOR_SERVE="true"

# Analytics & Monitoring
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

# MVP 3.0 Feature Flags
EXPERIMENTS_ENABLED="false"
CONTENT_LLM_DRAFTS_ENABLED="false"

# Research / A/B stub (targeted | random) — legacy MVP 2.0
EXPERIMENT_VARIANT="targeted"

# Manual cron stub: POST /jobs/weekly-reports/run

# Item-quality calibration loop (item-quality-v1)
# Opt-in interval refresh of ItemStatistic + Question.itemQualityWeight.
# Unset (default) = disabled; deploy-time alternative is a platform cron
# hitting POST /jobs/item-statistics/refresh. Never runs on the student hot path.
# ITEM_STATS_REFRESH_INTERVAL_MINUTES="60"

# API
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Local dev only — serves PENDING_REVIEW questions from the milestone bank.
# Staging/production: omit or set to "false" so only APPROVED questions reach students.
ALLOW_PENDING_REVIEW_QUESTIONS="true"

# Staging example (do not enable pending review outside local dev):
# ALLOW_PENDING_REVIEW_QUESTIONS="false"
